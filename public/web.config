<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copied verbatim into dist\ on every `npm run build` (Vite's public/ convention),
  so this survives a fresh clone on any server without a manual IIS step.

  Only rule: reverse-proxy /collector-api/* to the collector's local API
  (127.0.0.1:8766 by default - see collector/src/server.js). The collector binds
  to loopback only, by design; the dashboard's own JS runs in the visitor's
  browser, not on the server, so without this rule VITE_COLLECTOR_URL would have
  to point a remote browser at the server's own loopback address, which cannot
  work. Routing it through this site's existing HTTPS binding means IIS itself
  makes the 127.0.0.1 call - no new open port, no separate certificate.

  Requires the IIS URL Rewrite and Application Request Routing (ARR) modules,
  and ARR's server-wide proxy feature enabled once - see collector/README.md
  "Expose it to the dashboard" for the exact install/enable steps. Without
  those two modules installed, this rule is inert (IIS ignores <rewrite> markup
  it can't parse) and static-file serving for the dashboard itself is unaffected.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Collector API reverse proxy" stopProcessing="true">
          <match url="^collector-api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8766/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
