# IAM Intelligence Microsoft Entra SPA application
# Public client ID only; never put a client secret in the browser.
VITE_ENTRA_CLIENT_ID=ab342dfc-cab4-45f3-acdb-3e49d606f418

# Multitenant organizational sign-in endpoint.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# How often the dashboard re-queries Microsoft Graph while the tab is open and
# authenticated, in seconds. Default/recommended 60; minimum enforced at 30 to
# reduce throttling risk on Graph report/beta endpoints (MFA registration,
# service-principal activity). This does NOT collect data when no browser tab
# is open/signed in - that requires a backend/unattended collector (see
# docs/PERMISSIONS.md).
VITE_REFRESH_INTERVAL_SECONDS=60

# Optional Active Directory Intelligence Agent.
# The agent is read-only. For local testing, bind it to 127.0.0.1.
VITE_AD_AGENT_URL=http://127.0.0.1:8765
# Optional pairing token used by the local AD agent. Do not reuse an enterprise secret here.
VITE_AD_AGENT_TOKEN=
